# Correct MIME types for crawlable SEO files
AddType application/xml .xml
AddType text/plain .txt

<Files "sitemap.xml">
    ForceType application/xml
</Files>

<Files "robots.txt">
    ForceType text/plain
</Files>

# The production build pre-renders each public route into its own directory,
# so Apache can serve /portsmouth-recovery/ -> /portsmouth-recovery/index.html.
DirectoryIndex index.html

# Unknown URLs should return a genuine 404 instead of the homepage with HTTP 200.
ErrorDocument 404 /404.html
